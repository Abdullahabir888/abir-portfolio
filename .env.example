# Contact form (used only by the serverless function in /api/contact.js — never exposed to the browser)
# 1. Create a free account at https://resend.com and make an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# 2. Where messages from the form should land
CONTACT_TO_EMAIL=abdullahabir888@gmail.com
# 3. Sender address. Use onboarding@resend.dev until you verify your own domain in Resend
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# 4. Optional: send the visitor a branded "thanks, got your message" email.
#    Only works after you verify your own domain in Resend (onboarding@resend.dev can only email you).
CONTACT_AUTOREPLY=false
# 5. Optional: your live site address, used in the email buttons/links
SITE_URL=https://abir-portfolio.vercel.app
